                Genre = &quot;ужасы, триллер&quot;,
                Year = 1996,
                Poster = &quot;/images/scream.jpg&quot;,
                Description = &quot;Таинственный убийца в маске начинает охоту на подростков небольшого американского города.&quot;
            }
        );

        db.SaveChanges();
    }
}

