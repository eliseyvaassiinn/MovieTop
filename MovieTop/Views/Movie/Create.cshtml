@model MovieTop.Models.Movie

@{
    ViewData["Title"] = "Добавить фильм";
}

<div class="container mt-5">
    <h1>Добавить фильм</h1>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Название</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Director" class="form-label">Режиссёр</label>
            <input asp-for="Director" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Genre" class="form-label">Жанр</label>
            <input asp-for="Genre" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Year" class="form-label">Год выпуска</label>
            <input asp-for="Year" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Poster" class="form-label">Путь к постеру</label>
            <input asp-for="Poster" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Описание</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="5"></textarea>
        </div>

        <button type="submit" class="btn btn-success">
            Добавить
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Назад
        </a>
    </form>
</div>