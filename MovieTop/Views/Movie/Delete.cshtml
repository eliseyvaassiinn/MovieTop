@model MovieTop.Models.Movie

@{
    ViewData["Title"] = "Удалить фильм";
}

<div class="container mt-5">
    <h1>Удалить фильм</h1>

    <div class="row">
        <div class="col-md-3">
            <img src="@Model.Poster"
                 alt="@Model.Title"
                 class="img-fluid rounded" />
        </div>

        <div class="col-md-9">
            <h2>@Model.Title</h2>

            <p>
                Вы действительно хотите удалить этот фильм?
            </p>

            <p>
                <strong>Режиссёр:</strong> @Model.Director
            </p>

            <p>
                <strong>Год:</strong> @Model.Year
            </p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Удалить
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Отмена
                </a>
            </form>
        </div>
    </div>
</div>