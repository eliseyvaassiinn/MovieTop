            new Movie
            {
                Title = &quot;Тед 2&quot;,
                Director = &quot;Сет Макфарлейн&quot;,
                Genre = &quot;комедия&quot;,
                Year = 2015,
                Poster = &quot;/images/ted2.webp&quot;,
                Description = &quot;Тед хочет доказать, что он является настоящей личностью и имеет право на собственную жизнь.&quot;
            },

            new Movie
            {
                Title = &quot;Человек-паук&quot;,
